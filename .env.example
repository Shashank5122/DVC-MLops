# SignalGEO local development configuration.
# Copy to `.env` and edit. NEVER commit a real `.env`.

# --- backend ---------------------------------------------------------------
# development | testing | production
SIGNALGEO_ENVIRONMENT=development

# docker-compose sets this to the postgres service; plain `make dev-backend` uses SQLite.
SIGNALGEO_DATABASE_URL=postgresql+psycopg://signalgeo:signalgeo@localhost:5432/signalgeo
# For a zero-setup local run without Docker, use instead:
# SIGNALGEO_DATABASE_URL=sqlite:///./signalgeo.db

SIGNALGEO_LOG_LEVEL=INFO
SIGNALGEO_LOG_JSON=true
SIGNALGEO_DB_ECHO=false
SIGNALGEO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PROVIDER POLICY — M1 hard kill-switch.
# Leave false. Setting it true in production is refused at startup.
SIGNALGEO_PROVIDER_CALLS_ENABLED=false
# Denied regardless of the switch above. Do not remove without written authorization (gate M5/W2).
SIGNALGEO_PROVIDER_DENYLIST=gemini-grounding-google-search,perplexity-agent-api

# --- frontend --------------------------------------------------------------
# Server-side only: the Next server proxies /api/backend/* here.
BACKEND_ORIGIN=http://localhost:8000

# --- postgres (docker-compose only) ---------------------------------------
POSTGRES_USER=signalgeo
POSTGRES_PASSWORD=signalgeo
POSTGRES_DB=signalgeo
